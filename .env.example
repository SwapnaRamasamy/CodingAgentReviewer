# Copy to .env. Never commit credentials.
# Local Ollama needs no model API key. Hosted presets accept keys in the app password field.
REVIEW_MODEL=qwen3.5-review:4b
REVIEW_QUALITY_MODEL=qwen3.5-review:4b
REVIEW_SECURITY_MODEL=qwen3.5-review:4b
REVIEW_TESTS_MODEL=qwen3.5-review:4b
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
GITHUB_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Optional alternative: local GitHub MCP server (stdio), configured by the operator.
GITHUB_MCP_COMMAND=
GITHUB_MCP_ARGS=[]
